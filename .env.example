# انسخ هذا الملف إلى .env.local في كل تطبيق (apps/admin, apps/rep, apps/store) وعبّئ القيم الفعلية.
# لا تضع قيمًا حقيقية هنا أبدًا — هذا الملف فقط لتوثيق أسماء المتغيرات المطلوبة.

# Supabase — القيم العامة (آمنة على الفرونت إند)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — يُستخدم فقط داخل Server Actions / Edge Functions (لا يظهر أبدًا في الفرونت إند أو المتصفح)
SUPABASE_SERVICE_ROLE_KEY=
