# مشروع Supabase الخاص بلوحة التحكم المركزية نفسها (منفصل تمامًا عن أي
# مشروع عميل) — نفس أسماء المتغيرات المتبعة بـ apps/admin عمدًا، لإعادة
# استخدام packages/database/{client,server,middleware}.ts كما هي لتسجيل
# الدخول العادي (بريد/كلمة مرور عبر Supabase Auth، وليس مفتاحًا ثابتًا).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Management API — لإنشاء مشروع جديد لكل عميل (Personal Access
# Token بمستوى المؤسسة + معرّف المؤسسة نفسها)
SUPABASE_MANAGEMENT_API_TOKEN=
SUPABASE_ORGANIZATION_ID=

# Railway API — لإنشاء 3 خدمات (admin/rep/store) جديدة لكل عميل
RAILWAY_API_TOKEN=

# مستودع الكود الذي تُربط به خدمات Railway الجديدة لكل عميل
CONTROL_PLANE_GITHUB_REPO=ibn-Lafi/system2026
CONTROL_PLANE_DEPLOYMENT_BRANCH=main
